# --- CaddyPanel .dockerignore ---
# Root of the build context for `docker build .` (single-image project).
# Patterns below are relative to this file's directory.

# Git
.git
.gitignore

# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
*.egg-info/
venv/
.venv/
env/
.env          # Do not include local .env files in the image
pip-wheel-metadata/
pip-selfcheck.json

# Docker
Dockerfile
docker-compose.yml
caddy_config_on_host/
caddy_data_on_host/
app_data_on_host/

# SQLite dev database — never embed it in the image.
# stats.db is created at runtime in the /app_data volume by
# stats_aggregator.init_stats_db() (see app.py), so no seed DB is needed.
stats.db
*.db

# Tests — not needed in the production image
tests/
conftest.py

# IDE / OS specific
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation
GEMINI.md
